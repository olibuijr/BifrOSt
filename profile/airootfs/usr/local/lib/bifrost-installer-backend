prepare_offline_mirror() {
    if (( MIRRORLIST_CHANGED == 0 )); then
        install -m 0644 "$MIRRORLIST" "$MIRRORLIST_BACKUP"
        printf 'Server = file://%s/repo/$repo/os/$arch\n' "$OFFLINE_DIR" >"$MIRRORLIST"
        chmod 0644 "$MIRRORLIST"
