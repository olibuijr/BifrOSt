#!/usr/bin/python3
"""Manage signed first-party BifrOSt Flatpak applications."""

from __future__ import annotations

import argparse
from dataclasses import asdict
import json
from pathlib import Path
import sys

sys.path.insert(0, "/usr/lib/bifrost-apps")
from manager import UpdateError, manager_from_environment  # noqa: E402


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    list_parser = subparsers.add_parser("list", help="list BifrOSt applications and update state")
    list_parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    list_parser.add_argument("--cached", action="store_true", help="do not refresh repository metadata")

    check_parser = subparsers.add_parser("check", help="check whether application updates are available")
    check_parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")

    for command, help_text in (
        ("install", "install a published BifrOSt application"),
        ("update", "update one installed BifrOSt application"),
        ("rollback", "roll back to the last version recorded before an update"),
        ("remove", "remove an installed BifrOSt application"),
    ):
        command_parser = subparsers.add_parser(command, help=help_text)
        command_parser.add_argument("app_id", help="application ID in the org.bifrost namespace")

    update_all_parser = subparsers.add_parser("update-all", help="update every installed BifrOSt application")
    update_all_parser.add_argument("--json", action="store_true", help="emit per-application results as JSON")
    return parser.parse_args()


def print_records(records, *, as_json: bool) -> None:
    if as_json:
        print(json.dumps([asdict(record) for record in records], indent=2, sort_keys=True))
        return
    if not records:
        print("No BifrOSt applications are published yet.")
        return
    for record in records:
        current = record.installed_version or "not installed"
        available = record.available_version or "unpublished"
        print(f"{record.app_id}\t{record.status}\t{current}\t{available}\t{record.name}")


def main() -> int:
    args = parse_args()
    manager = manager_from_environment()
    try:
        if args.command == "list":
            print_records(manager.catalog(refresh=not args.cached), as_json=args.json)
        elif args.command == "check":
            records = manager.catalog()
            updates = [record for record in records if record.status == "update"]
            if args.json:
                print(json.dumps([asdict(record) for record in updates], indent=2, sort_keys=True))
            else:
                print(f"{len(updates)} BifrOSt application update(s) available.")
                for record in updates:
                    print(f"- {record.name}: {record.installed_version} -> {record.available_version}")
        elif args.command == "install":
            manager.install(args.app_id)
            print(f"Installed {args.app_id}.")
        elif args.command == "update":
            manager.update(args.app_id)
            print(f"Updated {args.app_id}.")
        elif args.command == "update-all":
            results = manager.update_all()
            if args.json:
                print(json.dumps([asdict(result) for result in results], indent=2, sort_keys=True))
            else:
                for result in results:
                    detail = f": {result.error}" if result.error else ""
                    print(f"{result.app_id}\t{result.status}{detail}")
                completed = sum(result.status == "completed" for result in results)
                failed = sum(result.status == "failed" for result in results)
                print(f"Completed {completed} BifrOSt application update(s); {failed} failed.")
            if any(result.status == "failed" for result in results):
                return 1
        elif args.command == "rollback":
            commit = manager.rollback(args.app_id)
            print(f"Rolled back {args.app_id} to {commit}.")
        elif args.command == "remove":
            manager.remove(args.app_id)
            print(f"Removed {args.app_id}.")
        else:
            raise AssertionError(args.command)
    except UpdateError as error:
        print(f"bifrost-app-manager: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
