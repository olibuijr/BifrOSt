#!/usr/bin/python3
"""Accessible maintenance dashboard for an installed BifrOSt system."""
from __future__ import annotations

from dataclasses import asdict, is_dataclass
import locale
import sys
import threading
from typing import Any, Callable

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk

sys.path.insert(0, "/usr/lib/bifrost-maintenance")
from manager import manager_from_environment  # noqa: E402

