#!/usr/bin/python3
import json
import locale
import os
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, Gtk

MARKER = Path.home() / ".config/bifrost/welcome-dismissed"
STATE = Path("/etc/bifrost/install-state.json")
FORCE = "--show" in sys.argv
if FORCE:
    sys.argv.remove("--show")

TEXT = {
    "is": {
        "title": "Velkomin í BifrOSt",
        "subtitle": "Kerfið er tilbúið. Hér eru mikilvægustu upplýsingarnar fyrir fyrstu skrefin.",
        "updates": "Uppfærslur",
        "updates_body": "Opnaðu „BifrOSt uppfærsluaðstoð“ til að setja upp og uppfæra undirrituð BifrOSt forrit fyrir notandann þinn. Aðstoðin breytir ekki Arch Linux kerfinu. Fyrir kerfið sjálft skaltu keyra heila „sudo pacman -Syu“ færslu; ekki gera hlutauppfærslur.",
        "recovery": "Endurheimt og atvikaskrár",
        "recovery_body": "Keyrðu „bifrost-recovery-info“ til að skoða kerfið án breytinga. Uppsetningarskrár eru í /var/log/bifrost-installer/ og kerfisskrár má skoða með „journalctl -b“. Þetta eru greiningar- og endurheimtarupplýsingar, ekki loforð um sjálfvirka afturköllun.",
        "encryption": "Dulkóðun disks",
        "encryption_on": "Virk samkvæmt uppsetningarskrá.",
        "encryption_off": "Ekki virk samkvæmt uppsetningarskrá.",
        "unknown": "Ekki skráð; staðfestu með „bifrost-recovery-info“.",
        "profiles": "Valin snið",
        "base": "Grunnkerfi",
        "dev-rust": "Rust þróun",
        "dev-containers": "Gámaþróun",
        "dev-web": "Vefþróun",
        "dev-python": "Python þróun",
        "done": "Loka",
        "done_tip": "Loka kynningunni; hún opnast ekki sjálfkrafa aftur.",
    },
    "en": {
        "title": "Welcome to BifrOSt",
        "subtitle": "Your system is ready. These are the essentials for getting started.",
        "updates": "Updates",
        "updates_body": "Open “BifrOSt Update Assistant” to install and update signed BifrOSt applications for your user. The assistant does not modify the Arch Linux system. For the operating system itself, run the complete “sudo pacman -Syu” transaction; do not perform partial upgrades.",
        "recovery": "Recovery and logs",
        "recovery_body": "Run “bifrost-recovery-info” for read-only system discovery. Installer logs are in /var/log/bifrost-installer/ and system logs can be viewed with “journalctl -b”. These are diagnostic and recovery resources, not a promise of automatic rollback.",
        "encryption": "Disk encryption",
        "encryption_on": "Enabled according to the installation record.",
        "encryption_off": "Not enabled according to the installation record.",
        "unknown": "Not recorded; verify with “bifrost-recovery-info”.",
        "profiles": "Selected profiles",
        "base": "Base system",
        "dev-rust": "Rust development",
        "dev-containers": "Container development",
        "dev-web": "Web development",
        "dev-python": "Python development",
        "done": "Close",
        "done_tip": "Close the welcome; it will not open automatically again.",
    },
}
PROFILE_IDS = {"base", "dev-rust", "dev-containers", "dev-web", "dev-python"}


def load_state():
    try:
        value = json.loads(STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(value, dict) or value.get("schema_version") != 2:
        return None
    return value


def section(title, body):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    box.add_css_class("card")
    box.set_margin_top(6)
    box.set_margin_bottom(6)
    box.set_margin_start(6)
    box.set_margin_end(6)
    heading = Gtk.Label(label=title, xalign=0)
    heading.add_css_class("heading")
    heading.set_wrap(True)
    label = Gtk.Label(label=body, xalign=0)
    label.set_wrap(True)
    label.set_selectable(True)
    box.append(heading)
    box.append(label)
    return box


class Welcome(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.bifrost.Welcome")
        self.window = None
        self.language = "is" if (locale.getlocale()[0] or "").lower().startswith("is") else "en"
        self.state = load_state()
        self.shown = False

    def do_activate(self):
        if MARKER.exists() and not FORCE:
            self.quit()
            return
        if self.window:
            self.window.present()
            return
        self.window = Adw.ApplicationWindow(application=self, title=TEXT[self.language]["title"])
        self.window.set_default_size(680, 660)
        self.window.connect("close-request", self.on_close)

        header = Adw.HeaderBar()
        languages = Gtk.Box(spacing=3)
        is_button = Gtk.ToggleButton(label="Íslenska")
        en_button = Gtk.ToggleButton(label="English")
        en_button.set_group(is_button)
        is_button.set_active(self.language == "is")
        en_button.set_active(self.language == "en")
        is_button.connect("toggled", self.change_language, "is")
        en_button.connect("toggled", self.change_language, "en")
        languages.append(is_button)
        languages.append(en_button)
        header.pack_start(languages)

        self.page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.page.set_margin_top(24)
        self.page.set_margin_bottom(24)
        self.page.set_margin_start(24)
        self.page.set_margin_end(24)
        scroll = Gtk.ScrolledWindow(vexpand=True)
        scroll.set_child(self.page)
        layout = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        layout.append(header)
        layout.append(scroll)
        self.window.set_content(layout)
        self.render()
        self.window.present()
        self.shown = True

    def state_text(self, key):
        t = TEXT[self.language]
        if not self.state:
            return t["unknown"]
        if key == "encryption":
            value = self.state.get("encryption")
            if isinstance(value, bool):
                return t["encryption_on"] if value else t["encryption_off"]
            return t["unknown"]
        profiles = self.state.get("profiles")
        if not isinstance(profiles, list) or not profiles or any(item not in PROFILE_IDS for item in profiles):
            return t["unknown"]
        return ", ".join(t[item] for item in profiles)

    def render(self):
        while child := self.page.get_first_child():
            self.page.remove(child)
        t = TEXT[self.language]
        self.window.set_title(t["title"])
        title = Gtk.Label(label=t["title"], xalign=0)
        title.add_css_class("title-1")
        subtitle = Gtk.Label(label=t["subtitle"], xalign=0)
        subtitle.set_wrap(True)
        self.page.append(title)
        self.page.append(subtitle)
        self.page.append(section(t["updates"], t["updates_body"]))
        self.page.append(section(t["recovery"], t["recovery_body"]))
        self.page.append(section(t["encryption"], self.state_text("encryption")))
        self.page.append(section(t["profiles"], self.state_text("profiles")))
        dismiss = Gtk.Button(label=t["done"], halign=Gtk.Align.END)
        dismiss.add_css_class("suggested-action")
        dismiss.set_tooltip_text(t["done_tip"])
        dismiss.connect("clicked", lambda _button: self.window.close())
        dismiss.set_receives_default(True)
        self.window.set_default_widget(dismiss)
        self.page.append(dismiss)

    def change_language(self, button, language):
        if button.get_active() and self.language != language:
            self.language = language
            self.render()

    def on_close(self, _window):
        if self.shown:
            try:
                MARKER.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                temporary = MARKER.with_suffix(".tmp")
                temporary.write_text("shown-and-dismissed\n", encoding="utf-8")
                os.chmod(temporary, 0o600)
                temporary.replace(MARKER)
            except OSError:
                pass
        return False


raise SystemExit(Welcome().run(sys.argv))
