#!/usr/bin/python3
"""Graphical update assistant for first-party BifrOSt applications."""

from __future__ import annotations

import locale
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, GLib, Gtk

sys.path.insert(0, "/usr/lib/bifrost-apps")
from manager import UpdateError, manager_from_environment  # noqa: E402


TEXT = {
    "is": {
        "title": "BifrOSt uppfærsluaðstoð",
        "subtitle": "Örugg uppsetning og uppfærsla á BifrOSt forritum",
        "refresh": "Endurlesa",
        "update_all": "Uppfæra allt",
        "available": "Tiltækt",
        "installed": "Uppsett",
        "update": "Uppfærsla tiltæk",
        "install": "Setja upp",
        "withdrawn": "Ekki lengur gefið út",
        "update_action": "Uppfæra",
        "rollback": "Fara til baka",
        "remove": "Fjarlægja",
        "empty": "Engin BifrOSt forrit hafa verið gefin út enn.",
        "loading": "Sæki undirritaðar upplýsingar…",
        "working": "Vinn að breytingu…",
        "done": "Aðgerð tókst.",
        "partial": "{completed} uppfærslur tókust; {failed} mistókust.",
        "error": "Aðgerð mistókst",
        "unexpected": "Óvænt innri villa kom upp.",
        "versions": "Uppsett: {installed} · Tiltækt: {available}",
        "not_installed": "ekki uppsett",
        "unpublished": "ekki lengur gefið út",
        "security": "Forrit koma aðeins úr undirritaðri BifrOSt Flatpak-geymslu. Kerfisuppfærslur Arch Linux eru ekki framkvæmdar hér.",
    },
    "en": {
        "title": "BifrOSt Update Assistant",
        "subtitle": "Secure installation and updates for BifrOSt applications",
        "refresh": "Refresh",
        "update_all": "Update all",
        "available": "Available",
        "installed": "Installed",
        "update": "Update available",
        "install": "Install",
        "withdrawn": "Withdrawn",
        "update_action": "Update",
        "rollback": "Roll back",
        "remove": "Remove",
        "empty": "No BifrOSt applications have been published yet.",
        "loading": "Fetching signed repository metadata…",
        "working": "Applying change…",
        "done": "Operation completed.",
        "partial": "{completed} update(s) completed; {failed} failed.",
        "error": "Operation failed",
        "unexpected": "An unexpected internal error occurred.",
        "versions": "Installed: {installed} · Available: {available}",
        "not_installed": "not installed",
        "unpublished": "unpublished",
        "security": "Applications come only from the signed BifrOSt Flatpak repository. This assistant does not perform Arch Linux system upgrades.",
    },
}


class UpdateAssistant(Adw.Application):
    def __init__(self) -> None:
        super().__init__(application_id="org.bifrost.UpdateAssistant")
        self.language = "is" if (locale.getlocale()[0] or "").lower().startswith("is") else "en"
        self.manager = manager_from_environment()
        self.window = None
        self.page = None
        self.list_box = None
        self.status = None
        self.spinner = None
        self.refresh_button = None
        self.update_all_button = None
        self.title = None
        self.subtitle = None
        self.security = None
        self.records = []
        self.busy = False

    def do_activate(self) -> None:
        if self.window:
            self.window.present()
            return
        self.window = Adw.ApplicationWindow(application=self)
        self.window.set_default_size(780, 680)

        header = Adw.HeaderBar()
        languages = Gtk.Box(spacing=3)
        is_button = Gtk.ToggleButton(label="Íslenska")
        en_button = Gtk.ToggleButton(label="English")
        en_button.set_group(is_button)
        is_button.set_active(self.language == "is")
        en_button.set_active(self.language == "en")
        is_button.connect("toggled", self.change_language, "is")
        en_button.connect("toggled", self.change_language, "en")
        languages.append(is_button)
        languages.append(en_button)
        header.pack_start(languages)

        self.refresh_button = Gtk.Button(icon_name="view-refresh-symbolic")
        self.refresh_button.connect("clicked", lambda _button: self.refresh())
        header.pack_end(self.refresh_button)
        self.update_all_button = Gtk.Button()
        self.update_all_button.add_css_class("suggested-action")
        self.update_all_button.connect("clicked", self.on_update_all)
        header.pack_end(self.update_all_button)

        self.page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.page.set_margin_top(24)
        self.page.set_margin_bottom(24)
        self.page.set_margin_start(24)
        self.page.set_margin_end(24)

        self.title = Gtk.Label(xalign=0)
        self.title.add_css_class("title-1")
        self.subtitle = Gtk.Label(xalign=0)
        self.subtitle.add_css_class("dim-label")
        self.subtitle.set_wrap(True)
        self.security = Gtk.Label(xalign=0)
        self.security.add_css_class("card")
        self.security.set_wrap(True)
        self.security.set_margin_top(6)
        self.security.set_margin_bottom(6)
        self.security.set_margin_start(6)
        self.security.set_margin_end(6)
        self.page.append(self.title)
        self.page.append(self.subtitle)
        self.page.append(self.security)

        self.list_box = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.list_box.add_css_class("boxed-list")
        self.page.append(self.list_box)

        status_box = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
        self.spinner = Gtk.Spinner()
        self.status = Gtk.Label()
        status_box.append(self.spinner)
        status_box.append(self.status)
        self.page.append(status_box)

        scroll = Gtk.ScrolledWindow(vexpand=True)
        scroll.set_child(self.page)
        layout = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        layout.append(header)
        layout.append(scroll)
        self.window.set_content(layout)
        self.translate()
        self.window.present()
        self.refresh()

    def translate(self) -> None:
        text = TEXT[self.language]
        self.window.set_title(text["title"])
        self.title.set_label(text["title"])
        self.subtitle.set_label(text["subtitle"])
        self.security.set_label(text["security"])
        self.refresh_button.set_tooltip_text(text["refresh"])
        self.update_all_button.set_label(text["update_all"])
        self.render()

    def change_language(self, button, language: str) -> None:
        if button.get_active() and self.language != language:
            self.language = language
            self.translate()

    def set_busy(self, busy: bool, message: str = "") -> None:
        self.busy = busy
        self.refresh_button.set_sensitive(not busy)
        self.update_all_button.set_sensitive(not busy and any(record.status == "update" for record in self.records))
        if busy:
            self.spinner.start()
        else:
            self.spinner.stop()
        self.status.set_label(message)

    def clear_rows(self) -> None:
        while row := self.list_box.get_first_child():
            self.list_box.remove(row)

    def render(self) -> None:
        if not self.list_box:
            return
        text = TEXT[self.language]
        self.clear_rows()
        if not self.records:
            row = Adw.ActionRow(title=text["empty"])
            self.list_box.append(row)
            self.update_all_button.set_sensitive(False)
            return
        status_labels = {
            "available": text["available"],
            "installed": text["installed"],
            "update": text["update"],
            "withdrawn": text["withdrawn"],
        }
        for record in self.records:
            installed = record.installed_version or text["not_installed"]
            available = record.available_version or text["unpublished"]
            versions = text["versions"].format(installed=installed, available=available)
            subtitle = f"{status_labels[record.status]} · {versions}"
            if record.description:
                subtitle = f"{record.description}\n{subtitle}"
            row = Adw.ActionRow(title=record.name, subtitle=subtitle)
            row.set_subtitle_lines(3)
            action = Gtk.Button(valign=Gtk.Align.CENTER)
            if record.status == "available":
                action.set_label(text["install"])
            elif record.status == "update":
                action.set_label(text["update_action"])
                action.add_css_class("suggested-action")
            elif record.status == "withdrawn":
                action.set_label(text["remove"])
            else:
                action.set_visible(False)
            action.connect("clicked", self.on_action, record.app_id, record.status)
            action.set_sensitive(not self.busy)
            row.add_suffix(action)
            if record.rollback_available:
                rollback = Gtk.Button(label=text["rollback"], valign=Gtk.Align.CENTER)
                rollback.connect("clicked", self.on_rollback, record.app_id)
                rollback.set_sensitive(not self.busy)
                row.add_suffix(rollback)
            self.list_box.append(row)
        self.update_all_button.set_sensitive(not self.busy and any(record.status == "update" for record in self.records))

    def refresh(self, completion_message: str = "") -> None:
        if self.busy:
            return
        self.set_busy(True, TEXT[self.language]["loading"])

        def work():
            try:
                records = self.manager.catalog()
            except UpdateError as error:
                GLib.idle_add(self.finish_refresh, None, str(error), "")
            except Exception:
                GLib.idle_add(self.finish_refresh, None, TEXT[self.language]["unexpected"], "")
            else:
                GLib.idle_add(self.finish_refresh, records, None, completion_message)

        threading.Thread(target=work, daemon=True).start()

    def finish_refresh(self, records, error, completion_message):
        if error:
            self.records = []
            self.set_busy(False, f"{TEXT[self.language]['error']}: {error}")
        else:
            self.records = records
            self.set_busy(False, completion_message)
        self.render()
        return GLib.SOURCE_REMOVE

    def run_operation(self, callback) -> None:
        if self.busy:
            return
        self.set_busy(True, TEXT[self.language]["working"])
        self.render()

        def work():
            try:
                result = callback()
            except UpdateError as error:
                GLib.idle_add(self.finish_operation, str(error), None)
            except Exception:
                GLib.idle_add(self.finish_operation, TEXT[self.language]["unexpected"], None)
            else:
                GLib.idle_add(self.finish_operation, None, result)
        threading.Thread(target=work, daemon=True).start()

    def finish_operation(self, error, result):
        if error:
            self.set_busy(False, f"{TEXT[self.language]['error']}: {error}")
            self.render()
        else:
            results = result if isinstance(result, list) else []
            failed = sum(getattr(item, "status", None) == "failed" for item in results)
            completed = sum(getattr(item, "status", None) == "completed" for item in results)
            if failed:
                message = TEXT[self.language]["partial"].format(completed=completed, failed=failed)
            else:
                message = TEXT[self.language]["done"]
            self.set_busy(False, "")
            self.refresh(message)
        return GLib.SOURCE_REMOVE

    def on_action(self, _button, app_id: str, status: str) -> None:
        if status == "available":
            self.run_operation(lambda: self.manager.install(app_id))
        elif status == "update":
            self.run_operation(lambda: self.manager.update(app_id))
        elif status == "withdrawn":
            self.run_operation(lambda: self.manager.remove(app_id))

    def on_rollback(self, _button, app_id: str) -> None:
        self.run_operation(lambda: self.manager.rollback(app_id))

    def on_update_all(self, _button) -> None:
        self.run_operation(self.manager.update_all)


raise SystemExit(UpdateAssistant().run(sys.argv))
