#!/usr/bin/python3
import json
import locale
import os
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk

MARKER = Path.home() / ".config/bifrost/welcome-dismissed"
STATE = Path("/etc/bifrost/install-state.json")
FORCE = "--show" in sys.argv
if FORCE:
    sys.argv.remove("--show")

TEXT = {
    "is": {
        "title": "Velkomin í BifrOSt",
